{
  "name": "orderflow-fix-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:mock": "vite --mode mock --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/check-production.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "react": "19.2.0", "react-dom": "19.2.0", "zod": "4.1.12" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/user-event": "^14.6.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
